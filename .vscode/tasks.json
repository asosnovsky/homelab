{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Dev Server - Start",
            "type": "shell",
            "command": "k3d cluster create -c k3d-default.yaml && docker logs -f k3d-k3s-default-server-0",
            "icon": {
                "id": "play-circle"
            }
        },
        {
            "label": "Dev Server - Logs",
            "type": "shell",
            "command": "docker logs -f k3d-k3s-default-server-0",
            "icon": {
                "id": "tree-filter-on-type-off"
            }
        },
        {
            "label": "Stop Dev Server",
            "type": "shell",
            "command": "k3d cluster delete -c k3d-default.yaml",
            "icon": {
                "id": "stop-circle"
            }
        },
        {
            "label": "Open Local Argo Port",
            "type": "shell",
            "command": "kubectl port-forward svc/argocd-server -n argocd 8080:80",
            "icon": {
                "id": "circuit-board"
            }
        }
    ]
}